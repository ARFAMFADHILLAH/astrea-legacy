# Salin file ini menjadi .env lalu isi dengan nilai dari
# Supabase Dashboard -> Project Settings -> API.
# Jangan pernah memakai service_role key di frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini

# Mode build:
#   public -> situs toko (deploy ke Vercel)
#   admin  -> panel admin (deploy ke Cloudflare Pages)
#   all    -> development lokal (default saat npm run dev)
VITE_APP_MODE=all

# URL situs publik (untuk link "Lihat Toko" di panel admin).
# Isi saat deploy ke Cloudflare Pages (mode admin).
# Contoh: VITE_PUBLIC_URL=https://toko-anda.vercel.app
VITE_PUBLIC_URL=