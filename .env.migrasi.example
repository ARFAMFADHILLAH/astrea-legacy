# Dipakai HANYA oleh scripts/import-legacy.mjs (impor data lama).
# Salin menjadi .env.migrasi. File .env.migrasi sudah masuk .gitignore.
#
# Ambil dari Supabase Dashboard -> Project Settings -> API:
#   - Project URL          -> SUPABASE_URL
#   - service_role secret  -> SUPABASE_SERVICE_ROLE_KEY
#
# JANGAN pernah menaruh service_role key di .env / kode frontend / Vercel.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini
